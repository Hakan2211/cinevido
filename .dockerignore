# Dependencies
node_modules/

# Build outputs
.output/
dist/
build/

# Development files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (secrets)
.env
.env.local
.env.*.local

# Database files
*.db
*.db-journal
prisma/data/

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Git
.git/
# NOTE: keep .gitignore in the build context. Tailwind v4 uses it to decide
# which files to scan for classes; without it the server build also scans the
# client output in .output/, produces different CSS, and links a stylesheet
# hash that doesn't exist in production (unstyled site).

# Testing
coverage/
.nyc_output/

# Misc
*.md
!README.md
LICENSE
.tanstack/
